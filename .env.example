# Supabase project URL. Safe to expose: it is the public REST/Storage origin.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key. Safe to expose: every request it makes is
# still filtered by Row Level Security.
#
# NEVER add a service-role / secret key here or to any NEXT_PUBLIC_* variable.
# The admin dashboard authenticates as a real Supabase Auth user and is
# authorised by profiles.role = 'admin' through public.is_admin(). It does not
# bypass RLS, and it must never need to.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# --- Testing only (optional) ---
# Credentials for the Playwright admin tests. Without them the admin specs skip
# themselves rather than failing, so `npm test` stays green either way.
#
# These tests write to the real Supabase project — there is no separate test
# database. Everything they create is prefixed ZZTEST- and deleted again.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
